{
  "name": "pakistan-address-react",
  "version": "0.2.1",
  "description": "Cascading Province, Division, District and Tehsil address fields for React, with an \"Other / not listed\" option at every level. Built on pakistan-address.",
  "keywords": [
    "pakistan",
    "address",
    "react",
    "cascading-select",
    "dropdown",
    "tehsil",
    "district"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "pakistan-address": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-select": "^5.10.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhairAhmad/pakistan-address.git",
    "directory": "packages/pakistan-address-react"
  },
  "homepage": "https://github.com/zhairAhmad/pakistan-address#readme",
  "bugs": {
    "url": "https://github.com/zhairAhmad/pakistan-address/issues"
  },
  "author": "Zhair Ahmad"
}
