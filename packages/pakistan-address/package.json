{
  "name": "pakistan-address",
  "version": "0.1.0",
  "description": "Pakistan's administrative hierarchy (province, division, district, tehsil) as typed JSON and tiny helpers for cascading address dropdowns. Zero dependencies.",
  "keywords": ["pakistan", "address", "province", "division", "district", "tehsil", "dropdown", "geo"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./data.json": "./data/pakistan.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "data", "README.md", "DATA.md", "NOTICE", "LICENSE"],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && tsup",
    "test": "npm run validate && vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/pakistan-address.git", "directory": "packages/pakistan-address" }
}
